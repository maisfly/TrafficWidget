<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/monthly_title"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/ink" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/tab_bar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_tab_bar"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_day"
                style="@style/TabItem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/tab_day" />

            <TextView
                android:id="@+id/tab_week"
                style="@style/TabItem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/tab_week" />

            <TextView
                android:id="@+id/tab_month"
                style="@style/TabItem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/tab_month" />
        </LinearLayout>

        <com.example.trafficwidget.SwipeTabLayout
            android:id="@+id/month_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_month_card"
            android:clipChildren="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <!-- Everything that slides during a tab switch lives in this container, so the
                 white card itself stays in place. -->
            <LinearLayout
                android:id="@+id/card_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/month_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/month_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="—"
                    android:textColor="@color/ink"
                    android:textSize="40sp" />

                <!-- Fixed height: the day chart and the week/month block both fill it, so the
                     card never changes height while switching. -->
                <FrameLayout
                    android:id="@+id/chart_area"
                    android:layout_width="match_parent"
                    android:layout_height="384dp"
                    android:layout_marginTop="2dp">

                    <com.example.trafficwidget.MonthlyUsageChartView
                        android:id="@+id/month_chart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:contentDescription="@string/month_chart_description"
                        android:focusable="true" />

                    <LinearLayout
                        android:id="@+id/period_block"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/period_average"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/ink_muted"
                            android:textSize="12sp" />

                        <com.example.trafficwidget.PeriodBarChartView
                            android:id="@+id/period_chart"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="4dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/week_chart_description" />

                        <TextView
                            android:id="@+id/period_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_period_summary"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="11dp"
                            android:textColor="#3A56D4"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/month_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:text="@string/loading_month"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/app_details_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/app_details_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/app_details_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/today_app_details"
                            android:textColor="@color/ink"
                            android:textSize="17sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/ink_faint" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.example.trafficwidget.SwipeTabLayout>
    </LinearLayout>
</ScrollView>
