<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.trafficwidget"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="37" />

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name="com.example.trafficwidget.TrafficApplication"
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.TrafficWidget" >
        <activity
            android:name="com.example.trafficwidget.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.trafficwidget.MonthlyUsageActivity"
            android:exported="false"
            android:theme="@style/Theme.TrafficWidget" />
        <activity
            android:name="com.example.trafficwidget.DataUsageProxyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.TrafficWidget.Transparent" />

        <!-- ==================== 原有 2x2 小部件 ==================== -->
        <receiver
            android:name="com.example.trafficwidget.TrafficWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name1" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/traffic_widget_info" />
        </receiver>

        <!-- ==================== 新增的 2x1 小部件 ==================== -->
        <receiver
            android:name="com.example.trafficwidget.TrafficWidget2x1Provider"
            android:exported="true"
            android:label="@string/widget_name2" > <!-- ⚠️ 注意：这里用了一个新的名字 -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/traffic_widget_2x1_info" /> <!-- 指向新的配置文件 -->
        </receiver>
        <!-- ======================================================== -->

        <service
            android:name="com.example.trafficwidget.WidgetRefreshJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name="com.example.trafficwidget.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- <receiver -->
        <!-- android:name=".ScreenStateReceiver" -->
        <!-- android:exported="true"> -->
        <!-- <intent-filter> -->
        <!-- &lt;!&ndash; SCREEN_ON / SCREEN_OFF are not delivered to manifest receivers; the -->
        <!-- desktop redraw (onAppWidgetOptionsChanged) and the 15-minute job drive -->
        <!-- refreshes instead. &ndash;&gt; -->
        <!-- <action android:name="android.intent.action.USER_PRESENT" /> -->
        <!-- </intent-filter> -->
        <!-- </receiver> -->
    </application>

</manifest>